<yandex>
    <http_server_default_response>
        <access_control_allow_origin>*</access_control_allow_origin>
        <access_control_allow_headers>authorization,content-type</access_control_allow_headers>
        <access_control_allow_methods>GET,POST,OPTIONS</access_control_allow_methods>
        <access_control_allow_credentials>true</access_control_allow_credentials>
    </http_server_default_response>

    <http_handlers>
        <rule>
            <url>/</url>
            <methods>POST,GET,OPTIONS</methods>
            <handler>
                <type>dynamic_query_handler</type>
                <query_param_name>query</query_param_name>
            </handler>
        </rule>
    </http_handlers>
    <kafka>
        <auto_offset_reset>earliest</auto_offset_reset>
