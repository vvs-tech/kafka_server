<!--        <ssl_keystore_location>/opt/spark/conf/kafka.keystore.jks</ssl_keystore_location>-->
<!--        <ssl_keystore_password><![CDATA[wAUyWEpL<>tWU9VxcAipcZP]]></ssl_keystore_password>-->
<!--        <ssl_key_password><![CDATA[wAUyWEpL<>tWU9VxcAipcZP]]></ssl_key_password>-->
<!--        <ssl_endpoint_identification_algorithm></ssl_endpoint_identification_algorithm>-->
        <ssl>
            <ca_cert>/opt/spark/conf/client.crt</ca_cert> <!-- путь к CA сертификату -->
            <client_cert>/opt/spark/conf/ca-cert.pem</client_cert> <!--  путь к клиентскому сертификату -->
            <client_key>/opt/spark/conf/client.key</client_key> <!--  путь к клиентскому ключу -->
        </ssl>
    </kafka>
</yandex>

